<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- Versión de producto: la que ve la persona. Se sube a propósito en cada entrega. -->
    <DisplayVersion>1.7.2</DisplayVersion>
    <!-- Versión de los ficheros: se cambia con -p:Version para pedir otra evaluación a Smart App Control. -->
    <Version>1.0.0</Version>
    <Company>Arkko</Company>
    <Product>Arkko</Product>
  </PropertyGroup>
</Project>
