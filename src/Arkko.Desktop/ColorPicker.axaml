<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arkko.Desktop.ColorPicker">
    <StackPanel Width="220">
        <!-- CUADRO: la saturación crece hacia la derecha y el brillo hacia arriba, sobre el tono elegido -->
        <Panel Name="Square" Height="140" Cursor="Cross" Background="Transparent"
               PointerPressed="Square_PointerPressed" PointerMoved="Square_PointerMoved" PointerReleased="Drag_PointerReleased">
            <Border Name="HueFill" CornerRadius="6" />
            <Border CornerRadius="6">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="6" BorderBrush="{DynamicResource TrackEdge}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse Name="SquareThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Panel>

        <!-- BARRA DE TONO: la vuelta entera al círculo de color, de rojo a rojo -->
        <Panel Name="HueBar" Height="14" Margin="0,10,0,0" Cursor="Hand" Background="Transparent"
               PointerPressed="Hue_PointerPressed" PointerMoved="Hue_PointerMoved" PointerReleased="Drag_PointerReleased">
            <Border CornerRadius="7" BorderBrush="{DynamicResource TrackEdge}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Border Name="HueThumb" Width="8" Height="18" Canvas.Top="-2" CornerRadius="3" BorderBrush="White" BorderThickness="2"
                        BoxShadow="0 0 3 0 #B3000000" />
            </Canvas>
        </Panel>

        <!-- RESULTADO: la muestra, su código y el botón que lo deja en el campo -->
        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Theme="{StaticResource ChipButton}" Content="Usar" Click="Use_Click"
                    ToolTip.Tip="Dejar este color en el campo del código" />
            <Border Name="Preview" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource TrackEdge}" BorderThickness="1" />
            <TextBlock Name="HexText" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                       Foreground="{DynamicResource Fg}" />
        </DockPanel>
    </StackPanel>
</UserControl>
