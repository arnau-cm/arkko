<Project Sdk="Microsoft.NET.Sdk">

  <!-- La ventana de Arkko (Avalonia). Va fuera de Arkko.sln: pide el SDK 10, que no está en el PATH
       ni en Visual Studio 17.14. Se compila con scripts\build-desktop.ps1. -->
  <!-- Para Windows se compila con sus APIs (las notificaciones modernas); para macOS y Linux, con .NET a secas.
       Decide el runtime pedido o, sin él, el sistema en que se compila. -->
  <PropertyGroup>
    <ForWindows Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">true</ForWindows>
    <ForWindows Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</ForWindows>
    <TargetFramework Condition="'$(ForWindows)' == 'true'">net10.0-windows10.0.17763.0</TargetFramework>
    <TargetFramework Condition="'$(ForWindows)' != 'true'">net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Arkko</AssemblyName>
    <RootNamespace>Arkko.Desktop</RootNamespace>
    <Product>Arkko</Product>
    <AssemblyTitle>Arkko</AssemblyTitle>
    <ApplicationIcon>Assets\arkko.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Smart App Control bloquea en este PC el compilador de XAML de la 12.1.3 y el núcleo de la 12.1.2:
         se ejecuta con la 12.1.3 y se compila el XAML con el compilador de la 12.1.2. -->
    <AvaloniaBuildTasksLocation>$(NuGetPackageRoot)avalonia/12.1.2/tools/netstandard2.0/Avalonia.Build.Tasks.dll</AvaloniaBuildTasksLocation>
    <!-- BuildTag cambia solo esta DLL: permite pedir otra evaluación a Smart App Control sin recompilar Core. -->
    <InformationalVersion Condition="'$(BuildTag)' != ''">$(Version)+$(BuildTag)</InformationalVersion>
  </PropertyGroup>

  <!-- .NET compacta los objetos grandes cuando dejan muchos huecos y devuelve antes la memoria que ya no usa:
       una app que pasa el día abierta pesa menos, a cambio de recolecciones algo más largas. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageDownload Include="Avalonia" Version="[12.1.2]" />
  </ItemGroup>

  <!-- La página de Sesiones (Web) se lee como fichero junto al ejecutable. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\arkko.ico" />
    <AvaloniaResource Include="Assets\arkko-48.png" />
    <AvaloniaResource Include="Assets\arkko-claro.ico" />
    <AvaloniaResource Include="Assets\arkko-claro-48.png" />
    <AvaloniaResource Include="Assets\logos\python.png" />
    <Content Include="Assets\arkko-notificacion.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\arkko-notificacion-modo-oscuro.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\arkko-notificacion-modo-claro.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Lo que usa APIs de Windows (notificaciones modernas, traer la terminal al frente) solo se compila para Windows. -->
  <ItemGroup Condition="'$(ForWindows)' != 'true'">
    <Compile Remove="Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DisplayVersion" Value="$(DisplayVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildTag)' != ''">
    <AssemblyMetadata Include="BuildTag" Value="$(BuildTag)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arkko.Core\Arkko.Core.csproj" />
  </ItemGroup>

</Project>
